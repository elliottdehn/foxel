place eyes +0 +15 +0
place fangs +0 +4 +0

anim crawl 1.1s loop:
0%: root +0 -0.5 +0
25%: root +0.6 +0.4 +0
50%: root +0 -0.5 +0
75%: root -0.6 +0.4 +0
0%: abd +0 +0.5 +0
25%: abd -0.9 -0.3 +0
50%: abd +0 +0.5 +0
75%: abd +0.9 -0.3 +0
64%: foot_l1 +0 +0 -3.2 linear
79%: foot_l1 +0 +2.6 +0.6
94%: foot_l1 +0 +0 +3.2 ease-out
11%: foot_l2 +0 +0 -3.2 linear
26%: foot_l2 +0 +2.6 +0.6
41%: foot_l2 +0 +0 +3.2 ease-out
58%: foot_l3 +0 +0 -3.2 linear
73%: foot_l3 +0 +2.6 +0.6
88%: foot_l3 +0 +0 +3.2 ease-out
5%: foot_l4 +0 +0 -3.2 linear
20%: foot_l4 +0 +2.6 +0.6
35%: foot_l4 +0 +0 +3.2 ease-out
14%: foot_r1 +0 +0 -3.2 linear
29%: foot_r1 +0 +2.6 +0.6
44%: foot_r1 +0 +0 +3.2 ease-out
61%: foot_r2 +0 +0 -3.2 linear
76%: foot_r2 +0 +2.6 +0.6
91%: foot_r2 +0 +0 +3.2 ease-out
8%: foot_r3 +0 +0 -3.2 linear
23%: foot_r3 +0 +2.6 +0.6
38%: foot_r3 +0 +0 +3.2 ease-out
55%: foot_r4 +0 +0 -3.2 linear
70%: foot_r4 +0 +2.6 +0.6
85%: foot_r4 +0 +0 +3.2 ease-out
---
anim walk 0.65s loop:
0%: root +0 +0.45 +0
25%: root +0.35 +0.95 +0
50%: root +0 +0.45 +0
75%: root -0.35 +0.95 +0
0%: abd +0 +0.8 +0
25%: abd -0.5 +0.2 +0.3
50%: abd +0 +0.8 +0
75%: abd +0.5 +0.2 +0.3
66%: foot_l1 +0 +0 -2.3 linear
82%: foot_l1 +0 +3.4 +0.8
96%: foot_l1 +0 +0.2 +2.3 ease-out
14%: foot_l2 +0 +0 -2.3 linear
30%: foot_l2 +0 +3.4 +0.8
44%: foot_l2 +0 +0.2 +2.3 ease-out
62%: foot_l3 +0 +0 -2.3 linear
78%: foot_l3 +0 +3.4 +0.8
92%: foot_l3 +0 +0.2 +2.3 ease-out
10%: foot_l4 +0 +0 -2.3 linear
26%: foot_l4 +0 +3.4 +0.8
40%: foot_l4 +0 +0.2 +2.3 ease-out
16%: foot_r1 +0 +0 -2.3 linear
32%: foot_r1 +0 +3.4 +0.8
46%: foot_r1 +0 +0.2 +2.3 ease-out
64%: foot_r2 +0 +0 -2.3 linear
80%: foot_r2 +0 +3.4 +0.8
94%: foot_r2 +0 +0.2 +2.3 ease-out
12%: foot_r3 +0 +0 -2.3 linear
28%: foot_r3 +0 +3.4 +0.8
42%: foot_r3 +0 +0.2 +2.3 ease-out
60%: foot_r4 +0 +0 -2.3 linear
76%: foot_r4 +0 +3.4 +0.8
90%: foot_r4 +0 +0.2 +2.3 ease-out
---
anim idle 3.2s loop:
0%: root +0 +0 +0
50%: root +0 -0.7 +0
0%: abd +0 +0 +0
30%: abd +0.5 +0.9 -0.5
65%: abd -0.5 -0.2 +0.2
0%: foot_l1 +0 +0 +0
0%: foot_l2 +0 +0 +0
0%: foot_l3 +0 +0 +0
0%: foot_l4 +0 +0 +0
0%: foot_r1 +0 +0 +0
0%: foot_r2 +0 +0 +0
0%: foot_r3 +0 +0 +0
0%: foot_r4 +0 +0 +0
38%: foot_r1 +0 +0 +0
46%: foot_r1 +0 +2.2 +1.5
54%: foot_r1 +0 +0 +0 ease-out
74%: foot_l1 +0 +0 +0
82%: foot_l1 +0 +2.2 +1.5
90%: foot_l1 +0 +0 +0 ease-out
---
anim threat 2.6s loop:
0%: root +0 +0 +0
30%: root +0 +2.8 -2 ease-out
62%: root +0 +2.8 -2
0%: abd +0 +0 +0
30%: abd +0 -1.5 -1.8
62%: abd +0 -1.5 -1.8
0%: foot_l3 +0 +0 +0
0%: foot_l4 +0 +0 +0
0%: foot_r3 +0 +0 +0
0%: foot_r4 +0 +0 +0
0%: foot_l1 +0 +0 +0
32%: foot_l1 -4.5 +10.5 +2 ease-out
60%: foot_l1 -4.5 +10.5 +2
0%: foot_l2 +0 +0 +0
36%: foot_l2 -4.5 +8 +1 ease-out
64%: foot_l2 -4.5 +8 +1
0%: foot_r1 +0 +0 +0
34%: foot_r1 +4.5 +10.5 +2 ease-out
62%: foot_r1 +4.5 +10.5 +2
0%: foot_r2 +0 +0 +0
38%: foot_r2 +4.5 +8 +1 ease-out
66%: foot_r2 +4.5 +8 +1
---

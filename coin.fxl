# coin.fxl -- a spinning gold coin, hand-drawn 2D pixel art.
# One slot per frame; the named `face` frame is held for two frames.
2d
fps 10

o = 5C3D0F          # outline, dark brown
g = F4B41F          # gold
h = FFE289          # highlight
s = C4881B          # shade
d = A56D12          # emblem, dark gold
e = D89C22          # rim


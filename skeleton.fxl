# skeleton.fxl -- generated by make_skeleton.py, do not hand-edit.
# 43 x 96 x 22 voxels. Alpha mechanic (IMPL.md section 5):
#   B bone 255, b soft bone 192, h halo 96 (sub-threshold shell,
#   rounds joints/skull), t teeth, e dark socket walls, r red eyes.

B = F0EAD6          # bone, full density
b = F0EAD6C0        # soft bone, alpha 192
h = F0EAD640        # halo shell 1, alpha 64 (sub-threshold)
i = F0EAD61C        # halo shell 2, alpha 28
j = F0EAD60C        # halo shell 3, alpha 12
t = FBFBF2          # teeth
e = 16161CC8        # socket back wall: dark, recessed
r = FF2626          # eye glow: red dots in the sockets

# animation rig: joints are marked in the layers below with
# sudoku border notation (LANG.md section 7)
a = joint ankle_l
A = joint ankle_r
m = joint toe_l
M = joint toe_r
k = joint knee_l +z
K = joint knee_r +z
g = joint hip_l
G = joint hip_r
p = joint pelvis
w = joint wrist_l
W = joint wrist_r
f = joint hand_l
F = joint hand_r
o = joint elbow_l -x-y
O = joint elbow_r +x-y
c = joint chest
s = joint shoulder_l
S = joint shoulder_r
n = joint neck_top
d = joint head_top
spine = bone p c
neck = bone c n
head = bone n d
clav_l = bone c s
clav_r = bone c S
uarm_l = bone s o
uarm_r = bone S O
farm_l = bone o w
farm_r = bone O W
hand_l = bone w f +x+z
hand_r = bone W F -x+z
hip_l = bone p g
hip_r = bone p G
thigh_l = bone g k
thigh_r = bone G K
shin_l = bone k a
shin_r = bone K A
foot_l = bone a m
foot_r = bone A M


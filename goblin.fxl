c = joint chest
u = joint shoulder_l
U = joint shoulder_r
n = joint neck_top
d = joint head_top
spine = bone p c
neck = bone c n
head = bone n d
clav_l = bone c u
clav_r = bone c U
uarm_l = bone u o
uarm_r = bone U O
farm_l = bone o w
farm_r = bone O W
hand_l = bone w f +x+z
hand_r = bone W F -x+z
hip_l = bone p q
hip_r = bone p Q
thigh_l = bone q k
thigh_r = bone Q K
shin_l = bone k a
shin_r = bone K A
foot_l = bone a m
foot_r = bone A M

